    // ================================
    // 🔥 NYA REA-METODER
    // ================================

    /**
     * Hämta alla produkter som är markerade som på REA (on_sale = TRUE)
     */
    @Transactional(readOnly = true)
    public List<Product> findProductsOnSale() {
        log.info("🔥 Hämtar produkter på REA (on_sale = TRUE)");
        try {
            // Försök med nya repository-metoden
            return productRepository.findByOnSaleTrueAndActiveTrue()
                    .stream()
                    .map(this::enhanceProductWithImage)
                    .collect(Collectors.toList());
        } catch (Exception e) {
            log.warn("Repository-metod finns inte än, använder fallback: {}", e.getMessage());
            try {
                // Fallback - använd findAll och filtrera i Java
                return productRepository.findAll().stream()
                        .filter(Product::isOnSale)
                        .filter(Product::isActive)
                        .map(this::enhanceProductWithImage)
                        .collect(Collectors.toList());
            } catch (Exception fallbackError) {
                log.error("Fallback misslyckades, använder proxy: {}", fallbackError.getMessage());
                return productRepository.findSaleProductsProxy()
                        .stream()
                        .map(this::enhanceProductWithImage)
                        .collect(Collectors.toList());
            }
        }
    }

    /**
     * Hämta endast produkter där REA:n är aktiv just nu (inom datum)
     */
    @Transactional(readOnly = true)
    public List<Product> findActiveSaleProducts() {
        log.info("🔥 Hämtar aktiva REA-produkter (inom datum)");
        try {
            LocalDateTime now = LocalDateTime.now();
            return productRepository.findByOnSaleTrueAndActiveTrueAndSaleStartDateLessThanEqualAndSaleEndDateGreaterThanEqual(now, now)
                    .stream()
                    .map(this::enhanceProductWithImage)
                    .collect(Collectors.toList());
        } catch (Exception e) {
            log.warn("Repository-metod finns inte än, filtrerar i Java: {}", e.getMessage());
            // Fallback - filtrera manuellt
            return findProductsOnSale().stream()
                    .filter(product -> {
                        LocalDateTime now = LocalDateTime.now();
                        LocalDateTime start = product.getSaleStartDate();
                        LocalDateTime end = product.getSaleEndDate();

                        // Om inga datum är satta, är REA:n aktiv
                        if (start == null && end == null) return true;

                        // Om bara startdatum är satt
                        if (start != null && end == null) {
                            return !now.isBefore(start);
                        }

                        // Om bara slutdatum är satt
                        if (start == null && end != null) {
                            return !now.isAfter(end);
                        }

                        // Om båda datum är satta
                        return !now.isBefore(start) && !now.isAfter(end);
                    })
                    .collect(Collectors.toList());
        }
    }

    /**
     * Hämta kommande REA:or (startdatum i framtiden)
     */
    @Transactional(readOnly = true)
    public List<Product> findUpcomingSaleProducts() {
        log.debug("🔥 Hämtar kommande REA-produkter");
        try {
            LocalDateTime now = LocalDateTime.now();
            return productRepository.findByOnSaleTrueAndActiveTrueAndSaleStartDateGreaterThan(now)
                    .stream()
                    .map(this::enhanceProductWithImage)
                    .collect(Collectors.toList());
        } catch (Exception e) {
            log.warn("Repository-metod finns inte än, filtrerar i Java: {}", e.getMessage());
            return findProductsOnSale().stream()
                    .filter(product -> {
                        LocalDateTime start = product.getSaleStartDate();
                        return start != null && start.isAfter(LocalDateTime.now());
                    })
                    .collect(Collectors.toList());
        }
    }

    /**
     * Hämta utgångna REA:or (slutdatum i det förflutna)
     */
    @Transactional(readOnly = true)
    public List<Product> findExpiredSaleProducts() {
        log.debug("🔥 Hämtar utgångna REA-produkter");
        try {
            LocalDateTime now = LocalDateTime.now();
            return productRepository.findByOnSaleTrueAndActiveTrueAndSaleEndDateLessThan(now)
                    .stream()
                    .map(this::enhanceProductWithImage)
                    .collect(Collectors.toList());
        } catch (Exception e) {
            log.warn("Repository-metod finns inte än, filtrerar i Java: {}", e.getMessage());
            return findProductsOnSale().stream()
                    .filter(product -> {
                        LocalDateTime end = product.getSaleEndDate();
                        return end != null && end.isBefore(LocalDateTime.now());
                    })
                    .collect(Collectors.toList());
        }
    }

    /**
     * Sätt en produkt på REA med datum
     */
    @Transactional
    public void putProductOnSale(Long productId, BigDecimal salePrice,
                                 LocalDateTime startDate, LocalDateTime endDate, String description) {
        log.info("🔥 Sätter produkt {} på REA: {} kr", productId, salePrice);
        try {
            Optional<Product> productOpt = productRepository.findById(productId);
            if (productOpt.isPresent()) {
                Product product = productOpt.get();
                product.putOnSale(salePrice, startDate, endDate, description);
                productRepository.save(product);
                log.info("Produkt {} sattes på REA: {} kr (var {} kr)",
                        product.getName(), salePrice, product.getPrice());
            } else {
                log.error("Produkt {} hittades inte", productId);
                throw new RuntimeException("Produkten hittades inte");
            }
        } catch (Exception e) {
            log.error("Error putting product {} on sale: {}", productId, e.getMessage());
            throw new RuntimeException("Kunde inte sätta produkten på REA");
        }
    }

    /**
     * Sätt en produkt på REA utan slutdatum
     */
    @Transactional
    public void putProductOnSale(Long productId, BigDecimal salePrice, String description) {
        log.info("🔥 Sätter produkt {} på permanent REA: {} kr", productId, salePrice);
        try {
            Optional<Product> productOpt = productRepository.findById(productId);
            if (productOpt.isPresent()) {
                Product product = productOpt.get();
                product.putOnSale(salePrice, description);
                productRepository.save(product);
                log.info("Produkt {} sattes på permanent REA: {} kr",
                        product.getName(), salePrice);
            } else {
                log.error("Produkt {} hittades inte", productId);
                throw new RuntimeException("Produkten hittades inte");
            }
        } catch (Exception e) {
            log.error("Error putting product {} on permanent sale: {}", productId, e.getMessage());
            throw new RuntimeException("Kunde inte sätta produkten på REA");
        }
    }

    /**
     * Ta bort REA från en produkt
     */
    @Transactional
    public void removeProductFromSale(Long productId) {
        log.info("🔥 Tar bort REA från produkt: {}", productId);
        try {
            Optional<Product> productOpt = productRepository.findById(productId);
            if (productOpt.isPresent()) {
                Product product = productOpt.get();
                product.removeSale();
                productRepository.save(product);
                log.info("REA borttagen från produkt: {}", product.getName());
            } else {
                log.error("Produkt {} hittades inte", productId);
                throw new RuntimeException("Produkten hittades inte");
            }
        } catch (Exception e) {
            log.error("Error removing sale from product {}: {}", productId, e.getMessage());
            throw new RuntimeException("Kunde inte ta bort REA från produkten");
        }
    }

    /**
     * Automatisk cleanup av utgångna REA:or
     */
    @Transactional
    public int cleanupExpiredSales() {
        log.info("🔥 Kör automatisk cleanup av utgångna REA:or");
        try {
            List<Product> expiredSales = findExpiredSaleProducts();
            int count = 0;

            for (Product product : expiredSales) {
                if (product.isSaleExpired()) {
                    product.setOnSale(false);
                    productRepository.save(product);
                    count++;
                    log.info("Automatiskt inaktiverade utgången REA för: {}", product.getName());
                }
            }

            log.info("Cleanup slutförd: {} utgångna REA:or inaktiverade", count);
            return count;
        } catch (Exception e) {
            log.error("Error during sale cleanup: {}", e.getMessage());
            return 0;
        }
    }

    /**
     * Hämta REA-statistik
     */
    @Transactional(readOnly = true)
    public Map<String, Object> getSaleStatistics() {
        log.debug("🔥 Beräknar REA-statistik");
        try {
            Map<String, Object> stats = new HashMap<>();

            List<Product> allSales = findProductsOnSale();
            List<Product> activeSales = findActiveSaleProducts();
            List<Product> upcomingSales = findUpcomingSaleProducts();
            List<Product> expiredSales = findExpiredSaleProducts();

            stats.put("totalOnSale", allSales.size());
            stats.put("activeSales", activeSales.size());
            stats.put("upcomingSales", upcomingSales.size());
            stats.put("expiredSales", expiredSales.size());

            // Beräkna totala besparingar
            BigDecimal totalSavings = allSales.stream()
                    .filter(Product::isOnSale)
                    .map(Product::getSavings)
                    .reduce(BigDecimal.ZERO, BigDecimal::add);
            stats.put("totalSavings", totalSavings);

            // Genomsnittlig rabatt
            OptionalDouble avgDiscount = allSales.stream()
                    .filter(Product::isOnSale)
                    .mapToDouble(p -> p.getDiscountPercentage().doubleValue())
                    .average();
            stats.put("averageDiscount", avgDiscount.orElse(0.0));

            log.info("REA-statistik: {} totalt, {} aktiva, {} kommande, {} utgångna",
                    allSales.size(), activeSales.size(), upcomingSales.size(), expiredSales.size());

            return stats;
        } catch (Exception e) {
            log.error("Error calculating sale statistics: {}", e.getMessage());
            return Map.of("error", "Kunde inte beräkna statistik");
        }
    }

    // ================================
    // CRUD-OPERATIONER FÖR ADMIN
    // ================================

    public Product createProduct(Product product) {
        log.info("Skapar ny produkt: {}", product.getName());
        product.setId(null); // Säkerställ att det är en ny produkt
        return productRepository.save(product);
    }

    public Product updateProduct(Long id, Product updatedProduct) {
        log.info("Uppdaterar produkt med ID: {}", id);

        return productRepository.findById(id)
                .map(existingProduct -> {
                    updatedProduct.setId(id);
                    // TODO: Behåll timestamps när kolumnerna läggs till
                    return productRepository.save(updatedProduct);
                })
                .orElseThrow(() -> new RuntimeException("Produkt med ID " + id + " hittades inte"));
    }

    public void hardDeleteProduct(Long id) {
        log.warn("Permanent borttagning av produkt: {}", id);
        productRepository.deleteById(id);
    }

    // ================================
    // LAGERHANTERING
    // ================================

    public boolean updateStock(Long productId, Integer newQuantity) {
        log.info("Uppdaterar lager för produkt {} till {}", productId, newQuantity);

        return productRepository.findById(productId)
                .map(product -> {
                    product.setStockQuantity(newQuantity);
                    productRepository.save(product);
                    return true;
                })
                .orElse(false);
    }

    public boolean decreaseStock(Long productId, Integer quantity) {
        log.info("Minskar lager för produkt {} med {}", productId, quantity);

        return productRepository.findById(productId)
                .map(product -> {
                    if (product.getStockQuantity() >= quantity) {
                        product.setStockQuantity(product.getStockQuantity() - quantity);
                        productRepository.save(product);
                        return true;
                    }
                    log.warn("Otillräckligt lager för produkt {}. Finns: {}, Begärt: {}",
                            productId, product.getStockQuantity(), quantity);
                    return false;
                })
                .orElse(false);
    }

    // ================================
    // STATISTIK SOM FUNGERAR NU
    // ================================

    public long getTotalActiveProducts() {
        return productRepository.count(); // Alla produkter för nu
    }

    public long getTotalProductsOnSale() {
        try {
            return findProductsOnSale().size();
        } catch (Exception e) {
            return productRepository.findSaleProductsProxy().size(); // Fallback
        }
    }

    public BigDecimal getAveragePrice() {
        return productRepository.findAveragePrice();
    }

    // ================================
    // AVANCERAD SÖKNING OCH FILTRERING
    // ================================

    /**
     * Avancerad sökning med flera filter
     */
    public Page<Product> findProductsWithFilters(String category, BigDecimal minPrice,
                                                 BigDecimal maxPrice, Boolean inStock,
                                                 String searchTerm, Pageable pageable) {
        log.debug("Avancerad sökning med filter");
        Page<Product> results = productRepository.findProductsWithFilters(category, minPrice, maxPrice,
                inStock, searchTerm, pageable);

        // Förbättra bilder för filtrerade resultat
        List<Product> enhancedProducts = results.getContent()
                .stream()
                .map(this::enhanceProductWithImage)
                .collect(Collectors.toList());

        return new PageImpl<>(enhancedProducts, pageable, results.getTotalElements());
    }

    /**
     * Hitta relaterade produkter
     */
    public List<Product> getRelatedProducts(String category, Long excludeId, int limit) {
        log.debug("Hämtar relaterade produkter i kategori: {}", category);
        Pageable pageable = PageRequest.of(0, limit);
        return productRepository.findRelatedProductsByCategory(category, excludeId, pageable)
                .stream()
                .map(this::enhanceProductWithImage)
                .collect(Collectors.toList());
    }

